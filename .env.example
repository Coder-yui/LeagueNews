# PostgreSQL (used by Docker Compose and the API)
POSTGRES_DB=lol_daily_intel
POSTGRES_USER=lol
POSTGRES_PASSWORD=lol_local_password
DATABASE_URL=postgresql+psycopg://lol:lol_local_password@localhost:5432/lol_daily_intel

# OpenAI-compatible LLM provider (required; imports return 503 when the key is empty)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini

# DeepSeek example (recommended non-thinking model as of 2026-07)
# OPENAI_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-v4-flash

# Local app URLs
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Connector ingestion (remote images are downloaded locally; no paid provider is required)
MEDIA_ROOT=../../apps/web/public/media
MEDIA_MAX_BYTES=20971520
CONNECTOR_USER_AGENT=LoLDailyIntel/0.1 (local development)
X_COOKIE_FILE=.secrets/x-cookies.json
X_FETCH_LIMIT=10
WEIBO_BROWSER_PROFILE=.secrets/weibo-browser-profile
# Optional locally. For containers, mount the JSON created by:
# services\api\.venv\Scripts\python.exe -m scripts.export_weibo_cookies
WEIBO_COOKIE_FILE=
WEIBO_BROWSER_CHANNEL=msedge
WEIBO_BROWSER_HEADLESS=true
WEIBO_BROWSER_USER_AGENT=

# Durable end-to-end processing (ingestion -> analysis -> event aggregation)
PIPELINE_AUTOMATION_ENABLED=true
PIPELINE_WORKER_POLL_SECONDS=2
PIPELINE_WORKER_LEASE_SECONDS=300
PIPELINE_WORKER_HEARTBEAT_SECONDS=30
COLLECTION_SCHEDULER_POLL_SECONDS=5
COLLECTION_SCHEDULER_LEASE_MINUTES=30
COLLECTION_SCHEDULER_HEARTBEAT_SECONDS=60
DAILY_REPORT_AUTOMATION_ENABLED=true
DAILY_REPORT_GENERATION_HOUR=12
DAILY_REPORT_SCHEDULER_POLL_SECONDS=30

# pgAdmin web UI (local development only)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_local_password
RUMOR_EXPIRY_DAYS=14
