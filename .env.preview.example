# Domain-free preview mode. Caddy listens on HTTP inside the host, but the host port is
# bound to loopback only. Access it through an SSH tunnel; never expose port 8080 publicly.
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://localhost:8080
ACME_EMAIL=unused@example.com
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# Caddy Basic Auth for /admin and private API endpoints.
ADMIN_USERNAME=admin
# Generate on the server:
# docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext "your-password"
# Replace every "$" in the result with "$$" before saving it here.
ADMIN_PASSWORD_HASH=$$2a$$14$$replace_with_a_generated_hash

POSTGRES_DB=lol_daily_intel
POSTGRES_USER=lol
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

OPENAI_API_KEY=replace-with-the-production-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini

IMAGE_TAG=latest
API_IMAGE=ghcr.io/coder-yui/leaguenews-api
WEB_IMAGE=ghcr.io/coder-yui/leaguenews-web
DEPLOY_BUILD_LOCAL=false

CONNECTOR_USER_AGENT=LoLDailyIntel/1.0
SECRETS_DIR=../.secrets
X_FETCH_LIMIT=10
MEDIA_MAX_BYTES=20971520

PIPELINE_AUTOMATION_ENABLED=true
PIPELINE_WORKER_POLL_SECONDS=2
COLLECTION_SCHEDULER_POLL_SECONDS=5
COLLECTION_SCHEDULER_LEASE_MINUTES=30
