# Public hostname. Point its A/AAAA record to the deployment server first.
SITE_ADDRESS=news.example.com
PUBLIC_ORIGIN=https://news.example.com
ACME_EMAIL=admin@example.com
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Caddy Basic Auth for /admin and private API endpoints.
ADMIN_USERNAME=admin
# Generate with:
# docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext "a-long-random-password"
# Docker Compose treats "$" as interpolation. Replace every "$" in the generated hash with "$$".
ADMIN_PASSWORD_HASH=$$2a$$14$$replace_with_a_generated_hash

# Read-only MCP endpoint. Generate a long random value and keep it out of git.
# The service accepts this value in MCP_AUTH_HEADER (default: X-MCP-Service-Token).
# The production API validates the token and allowed hosts only when MCP_ENABLED=true.
MCP_PRODUCTION=true
MCP_ENABLED=true
MCP_SERVICE_TOKEN=replace-with-a-long-random-mcp-service-token
MCP_AUTH_HEADER=X-MCP-Service-Token
# Include the public Host header exactly as seen by the API, optionally with :port.
MCP_ALLOWED_HOSTS=news.example.com
MCP_ALLOWED_ORIGINS=

# Database. Generate a unique password; do not reuse this example.
POSTGRES_DB=lol_daily_intel
POSTGRES_USER=lol
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# LLM provider.
OPENAI_API_KEY=replace-with-the-production-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini

# Release/image settings. Increment IMAGE_TAG for each deployment.
IMAGE_TAG=latest
API_IMAGE=ghcr.io/coder-yui/leaguenews-api
WEB_IMAGE=ghcr.io/coder-yui/leaguenews-web
# Recommended: false (or unset) pulls GHCR production images.
# Set true only when API/Web must be built on the production server.
DEPLOY_BUILD_LOCAL=false

# Export .secrets/weibo-cookies.json with scripts.export_weibo_cookies first and
# copy only that cookie JSON to production. Chromium profiles use separate
# Docker managed volumes for the API and collection scheduler.
# Copy the User-Agent printed by that command; leave empty when Weibo is unused.
WEIBO_BROWSER_USER_AGENT=

# Feishu custom bots. Keep webhook URLs and signing secrets private.
FEISHU_FEATURED_PUSH_ENABLED=false
FEISHU_FEATURED_WEBHOOK_URL=
FEISHU_FEATURED_SECRET=
FEISHU_ALERT_PUSH_ENABLED=false
FEISHU_ALERT_WEBHOOK_URL=
FEISHU_ALERT_SECRET=
FEISHU_NOTIFICATION_POLL_SECONDS=5
FEISHU_NOTIFICATION_LEASE_SECONDS=120
FEISHU_ALERT_COOLDOWN_MINUTES=60

# Connector runtime.
CONNECTOR_USER_AGENT=LoLDailyIntel/1.0 (+https://news.example.com)
# Overseas production connects directly by default.
OUTBOUND_PROXY_URL=
SECRETS_DIR=../.secrets
X_FETCH_LIMIT=10
MEDIA_MAX_BYTES=20971520

# Durable automation.
PIPELINE_AUTOMATION_ENABLED=true
PIPELINE_WORKER_POLL_SECONDS=2
PIPELINE_WORKER_LEASE_SECONDS=300
PIPELINE_WORKER_HEARTBEAT_SECONDS=30
PIPELINE_WORKER_MAX_ATTEMPTS=4
COLLECTION_SCHEDULER_POLL_SECONDS=5
COLLECTION_SCHEDULER_LEASE_MINUTES=30
COLLECTION_SCHEDULER_HEARTBEAT_SECONDS=60
COLLECTION_RUN_TIMEOUT_SECONDS=300
RUMOR_EXPIRY_DAYS=14
